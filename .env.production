# app title
VUE_APP_TITLE="Hi-Class UI"

# production
VUE_APP_PRODUCTION=true
NODE_ENV=production

# chat api
VUE_APP_CHAT_API_SERVER_URI=https://chat.hiclass.net
# hiclass ui uri
VUE_APP_BASE_UI_URI=https://www.hiclass.net

# api uri
VUE_APP_BASE_API_URI=https://api.hiclass.net

# ad uri
