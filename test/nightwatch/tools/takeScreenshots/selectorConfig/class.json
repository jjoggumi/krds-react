  },
  {
    "name": "게시글 복사",
    "path": [
      {"action": "click", "selector": ".column-content div .hi-board.board__item:nth-child(1) .hi-kebabmenu .kebabmenu__layer .btn-copy"},
      {"action": "waitForElementPresent", "selector": ".modal-board-move-container"}
    ]
  },
  {
