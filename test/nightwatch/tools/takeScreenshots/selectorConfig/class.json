      {"action": "click", "selector": ".column-content div .hi-board.board__item:nth-child(1) .hi-kebabmenu .kebabmenu__layer .btn-export"},
      {"action": "waitForElementPresent", "selector": ".post-export-wrap"}
    ]
  },
  {
    "name": "게시글 내보내기 그룹 목록",
    "path": [{"action": "click", "selector": ".post-export-wrap .modal__content .hi-row .hi-btn"}],
    "after": [{"action": "click", "selector": ".post-export-wrap .modal__layer .modal__header .btn-close"}]
  },
  {
    "name": "알림함",
    "path": [
      {"action": "click", "selector": "#alarmBtn"},
      {"action": "waitForElementPresent", "selector": ".alarm-popup-box div.cont-wrap ul li:nth-child(1) span.date"}
