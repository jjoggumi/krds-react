  {
    "name": "게시글 검색",
    "path": [{"action": "click", "selector": ".board__filter.board__filter-fixed .searchbox__select .selected"}]
  },
  {
    "name": "수업 관리",
    "path": [{"action": "click", "selector": ".heading-board+.lnb__list+.heading-admin .btn-setting"}]
  },
  {
    "name": "초대하기",
    "path": [{"action": "click", "selector": ".class-top-heading .btn-invite"}]
  }
]